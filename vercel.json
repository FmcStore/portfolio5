{
  "rewrites": [
    { "source": "/", "destination": "/portofolio5/index.html" },
    { "source": "/about", "destination": "/portofolio5/about.html" },
    { "source": "/project", "destination": "/portofolio5/project.html" },
    { "source": "/contact", "destination": "/portofolio5/contact.html" },
    { "source": "/ai", "destination": "/ai/ai.html" }
  ],
  "redirects": [
    { "source": "/portofolio5/:path*", "destination": "/:path", "permanent": true },
    { "source": "/ai/ai.html", "destination": "/ai", "permanent": true },
    { "source": "/ai/index.html", "destination": "/ai", "permanent": true }
  ]
}
